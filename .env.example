DATA_HOST=127.0.0.1
DATA_PORT=8340
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8341
ANTHROPIC_ORIGIN=https://api.anthropic.com
OPENAI_ORIGIN=https://api.openai.com
ANTHROPIC_API_KEY_FILE=/run/secrets/refract/anthropic-api-key
OPENAI_API_KEY_FILE=/run/secrets/refract/openai-api-key
ADMIN_TOKEN_FILE=/run/secrets/refract/admin-token
DURABLE_DB_PATH=/var/lib/refract/observability.db
RAW_DB_PATH=/var/cache/refract/raw.db
RAW_CAPTURE_ENABLED=true
RAW_DOWNLOAD_ENABLED=false
MAX_CONCURRENT_REQUESTS=128
MAX_REQUEST_BODY_BYTES=67108864
MAX_HEADER_BYTES=32768
MAX_CONNECTIONS=1024
